/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Config file for defining DSL2 per module options and publishing paths
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Available keys to override module options:
        ext.args   = Additional arguments appended to command in module.
        ext.args2  = Second set of arguments appended to command in module (multi-tool modules).
        ext.args3  = Third set of arguments appended to command in module (multi-tool modules).
        ext.prefix = File name prefix for output files.
----------------------------------------------------------------------------------------
*/

process {
    withName: 'GFFREAD' {
        publishDir = [
            path: { "${params.outdir}/gffread" },
            mode: params.publish_dir_mode
        ]
    }

    withName: 'ORTHOFINDER' {
        publishDir = [
            path: { "${params.outdir}/orthofinder" },
            mode: params.publish_dir_mode
        ]
    }

    withName: 'EARLGREY' {
        publishDir = [
            path: { "${params.outdir}/earlgrey" },
            mode: params.publish_dir_mode
        ]
    }

    withName: 'HITE' {
        publishDir = [
            path: { "${params.outdir}/hite" },
            mode: params.publish_dir_mode
        ]
    }

    withName: 'PARSE_TE' {
        publishDir = [
            path: { "${params.outdir}/compare_te/per_method" },
            mode: params.publish_dir_mode,
            enabled: false
        ]
    }

    withName: 'COMBINE_TE' {
        publishDir = [
            path: { "${params.outdir}/compare_te" },
            mode: params.publish_dir_mode
        ]
    }

    // Wave is enabled globally and cannot ingest the nf-core modules' default
    // https:// galaxyproject singularity URLs, so make them use docker image
    // names (which Wave augments into Singularity images).
    withName: 'FAMDB_PY_EMBL' {
        ext.singularity_pull_docker_container = true
        publishDir = [
            path: { "${params.outdir}/repeatmasker/famdb" },
            mode: params.publish_dir_mode,
            enabled: false
        ]
    }

    withName: 'REPEATMODELER_BUILDDATABASE' {
        ext.singularity_pull_docker_container = true
        publishDir = [
            path: { "${params.outdir}/repeatmasker/repeatmodeler_db" },
            mode: params.publish_dir_mode,
            enabled: false
        ]
    }

    withName: 'REPEATMODELER_REPEATMODELER' {
        ext.singularity_pull_docker_container = true
        publishDir = [
            path: { "${params.outdir}/repeatmasker/repeatmodeler/${meta.id}" },
            mode: params.publish_dir_mode
        ]
    }

    withName: 'CAT_CAT' {
        ext.singularity_pull_docker_container = true
        ext.prefix = { "${meta.id}_combined_library.fasta" }
        publishDir = [
            path: { "${params.outdir}/repeatmasker/library" },
            mode: params.publish_dir_mode,
            enabled: false
        ]
    }

    withName: 'CDHIT_CDHITEST|MMSEQS_EASYCLUSTER|MMSEQS_EASYLINCLUST' {
        ext.singularity_pull_docker_container = true
        publishDir = [
            path: { "${params.outdir}/repeatmasker/library" },
            mode: params.publish_dir_mode
        ]
    }

    withName: 'REPEATMASKER_REPEATMASKER' {
        ext.singularity_pull_docker_container = true
        ext.args = {
            params.repeatmasker_speed == 'default' ? '' : "-${params.repeatmasker_speed}"
        }
        publishDir = [
            path: { "${params.outdir}/repeatmasker/${meta.id}" },
            mode: params.publish_dir_mode
        ]
    }

    withName: 'TE_TBL_2_TABLE' {
        ext.singularity_pull_docker_container = true
        publishDir = [
            path: { "${params.outdir}/repeatmasker" },
            mode: params.publish_dir_mode
        ]
    }

    withName: 'CUSTOM_DUMPSOFTWAREVERSIONS' {
        publishDir = [
            path: { "${params.outdir}/pipeline_info" },
            mode: params.publish_dir_mode,
            pattern: '*_versions.yml'
        ]
    }
}
