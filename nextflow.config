manifest {
  name            = 'comparete'
  description     = 'TE comparative analysis'
  author          = 'Chris Wyatt'
  version         = '1.0.5'
  nextflowVersion = '!>=26.04.0'
}

// Defaults parameters, expecting to be overwritten
params {
  // Path to results directory
  outdir                     = "results"
  // Path to input CSV
  input                      = null
  // Ensembl download options
  ensembl_biomart            = null
  ensembl_dataset            = null
  // Predownloaded fasta and go files
  predownloaded_fasta        = null
  predownloaded_gofiles      = null
  // Other options
  orthofinder                = false
  earlgrey                   = false
  hite                       = false
  // Dfam famdb directory for Earl Grey / RepeatMasker (bind-mounted into the container)
  famdb                      = null
  // Have limiting jobs be optional
  forks                      = null
  // Remove work directories upon pipeline completion
  clean                      = false
  // Architecture of platform pipeline is running on
  architecture               = "amd"
  // include basic config
  custom_config              = null
  // Max resource options
  max_memory                 = '128.GB'
  max_cpus                   =  16
  max_time                   = '48.h'
  // Display help message with nf-schema
  help = null
  // nf-core module parameters
  publish_dir_mode           = 'copy'
  // Timestamp shared by all pipeline_info report file names
  trace_report_suffix        = new java.util.Date().format( 'yyyy-MM-dd_HH-mm-ss')
}

plugins {
  id 'nf-co2footprint@1.4.0'
  id 'nf-schema@2.7.3'
  id 'nf-amazon@3.10.0'
}

// NOTE: nf-co2footprint 1.4.0 nests trace/report/provenance file paths and dropped
// summaryFile in favour of a provenance JSON file; machineType must be set or `pue`
// is silently ignored.
co2footprint {
    trace {
        file = "${params.outdir}/pipeline_info/co2_emissions/co2footprint_trace_${params.trace_report_suffix}.txt"
    }
    report {
        file = "${params.outdir}/pipeline_info/co2_emissions/co2footprint_report_${params.trace_report_suffix}.html"
    }
    provenance {
        file = "${params.outdir}/pipeline_info/co2_emissions/co2footprint_provenance_${params.trace_report_suffix}.json"
    }
    ci                  = 300
    pue                 = 1.4
    machineType         = 'local'
    ignoreCpuModel      = true
    powerdrawCpuDefault = 12.0
}

// Load base.config by default for all pipelines
includeConfig 'conf/base.config'

// Load custom config if provided (strict config syntax doesn't allow if/try-catch,
// so fall back to an empty no-op config when none is set)
includeConfig params.custom_config ?: 'conf/empty.config'

// Select a combination of useful profiles i.e. nextflow run -profile local,docker 
profiles {
  local {
    executor.name            = 'local'
  }
  aws_batch {
    includeConfig 'conf/aws_batch.config'
  }
  //Use Docker as the container management software
  docker {
    docker.enabled           = true
    // Remove docker containers after pipeline completes
    docker.remove            = true
    // Sets user for docker to the user who executes pipeline
    docker.runOptions        = '-u $(id -u):$(id -g)'
    // set registry to quay.io
    //docker.registry          = "quay.io"
    // Ensure other container engines are unset
    singularity.enabled      = false
    apptainer.enabled        = false
  }
  singularity {
    singularity.enabled      = true
    // Set where singularity cached images are saved
    singularity.cacheDir     = "singularity/cachedir"
    // set registry to quay.io
    //singularity.registry     = "quay.io"
    // Ensure other container engines are unset
    docker.enabled           = false
    apptainer.enabled        = false
  }
  apptainer {
    apptainer.autoMounts   = true
    apptainer.enabled        = true
    // Set where singularity cached images are saved
    apptainer.cacheDir       = "apptainer/cachedir"
    // set registry to quay.io
    // apptainer.registry       = "quay.io"
    // Ensure other container engines are unset
    docker.enabled           = false
    singularity.enabled      = false
  }
  test_bacteria { includeConfig 'conf/test_bacteria.config' }
  test_bacteria_ncbi { includeConfig 'conf/test_bacteria_ncbi.config' }
  test_drosophila { includeConfig 'conf/test_drosophila.config' }
  test_drosophila_genome { includeConfig 'conf/test_drosophila_genome.config' }
  // Institutional config for the UCL Myriad cluster
  ucl_myriad { includeConfig 'conf/ucl_myriad.config' }
  // Institutional config for the University of Cambridge CSD3 cluster
  cambridge { includeConfig 'conf/cambridge.config' }
}

// Load nf-core modules config
includeConfig 'conf/modules.config'

// Capture exit codes from upstream processes when piping
process.shell = ['/bin/bash', '-euo', 'pipefail']

// Capturing Nextflow log files into a rsults/pipeline_info directory
timeline {
    enabled = true
    file    = "${params.outdir}/pipeline_info/execution_timeline_${params.trace_report_suffix}.html"
}
report {
    enabled = true
    file    = "${params.outdir}/pipeline_info/execution_report_${params.trace_report_suffix}.html"
}
trace {
    enabled = true
    file    = "${params.outdir}/pipeline_info/execution_trace_${params.trace_report_suffix}.txt"
}
dag {
    enabled = true
    file    = "${params.outdir}/pipeline_info/pipeline_dag_${params.trace_report_suffix}.html"
}

// Ensures work directories and removed when pipeline completes
cleanup = params.clean

//Set max forks if parameter provided
process.maxForks = params.forks

env {
    BIOMART_CACHE = "./cache"
}

wave {
    enabled = true
}
